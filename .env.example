# Environment variable template — ROADMAP-001
# Copy to `.env` for local use. Never commit real secrets (vaaniq-core.mdc).

# --- Backend ---
VAANIQ_ENV=local
VAANIQ_LOG_LEVEL=INFO
# ASSUMPTION: OQ-021 — SQLite by default for local
VAANIQ_DATABASE_URL=sqlite:///./vaaniq.db
VAANIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VAANIQ_API_HOST=0.0.0.0
VAANIQ_API_PORT=8000
VAANIQ_MAX_UPLOAD_BYTES=26214400
VAANIQ_MAX_AUDIO_DURATION_SEC=120
VAANIQ_OBJECT_STORE_ROOT=./data/object_store
VAANIQ_EMBEDDING_CACHE_ROOT=./data/embedding_cache
VAANIQ_SEED=42

# Hugging Face (gated datasets / models) — optional until P2
# HF_TOKEN=

# --- Frontend (Vite) ---
# Local Vite dev server:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Docker/nginx same-origin build uses empty string (see deployment/README.md).

# --- Docker Compose (optional) ---
# VAANIQ_DATABASE_URL=postgresql+psycopg://vaaniq:vaaniq@db:5432/vaaniq
